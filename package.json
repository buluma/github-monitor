  "license": "MIT",
  "author": "Yoni",
  "homepage": "https://github.com/ryabinski-labs/github-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryabinski-labs/github-monitor.git"
  },
  "bugs": {
